{
  "name": "block-anim-factory",
  "version": "0.4.3",
  "private": true,
  "type": "module",
  "description": "积木动画工厂 · 用积木搭动画逻辑的可视化编程动画制作软件（零构建、零依赖纯前端）",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node scripts/test-all.mjs",
    "test:logic": "node run-tests.mjs",
    "test:audio": "node test-audio.mjs",
    "test:video": "node test-video.mjs",
    "test:custom": "node test-custom.mjs",
    "test:scene": "node test-scene.mjs",
    "test:node": "node test-node-batch.mjs",
    "test:v3v4": "node test-v3v4.mjs",
    "test:pipeline": "node test-pipeline.mjs",
    "test:browser": "node test-browser.mjs",
    "test:visual": "node test-visual.mjs",
    "test:markdirty": "node test-markdirty.mjs",
    "test:renderer-img": "node test-renderer-img.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test:gif": "node test-gif.mjs",
    "test:mp4": "node test-mp4.mjs",
    "screenshots": "node make-screenshots.mjs",
    "desktop:build": "dotnet publish desktop/BlockAnim.csproj -c Release -o desktop/out",
    "desktop:test": "node scripts/desktop-smoke.mjs",
    "desktop:clean": "node scripts/desktop-clean.mjs"
  },
  "keywords": [
    "animation",
    "visual-programming",
    "no-code",
    "canvas",
    "audio-driven",
    "subtitle",
    "video-export",
    "desktop",
    "webview2"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "playwright-core": "^1.64.0"
  }
}