<!--
  主窗口：WebView2 承载 Web 应用。
  WebView2 控件无法在设计器里预览，只能代码构建，
  所以 XAML 里只声明控件，加载完成前的占位由代码控制。
-->
<Window x:Class="BlockAnimDesktop.BlockAnim"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="积木动画工厂 · 可视化编程动画制作软件"
        Width="1600" Height="980"
        MinWidth="1100" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="#0b0e14">

  <Grid>
    <!-- 启动占位：避免 WebView2 初始化期间的白屏闪烁 -->
    <Border x:Name="LoadingPanel" Background="#0b0e14">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="积木动画工厂"
                   Foreground="#e6ecf5"
                   FontSize="26"
                   FontWeight="SemiBold"
                   HorizontalAlignment="Center"/>
        <TextBlock Text="正在启动…"
                   Foreground="#5a5f6e"
                   FontSize="13"
                   Margin="0,10,0,0"
                   HorizontalAlignment="Center"/>
        <ProgressBar Width="190" Height="3" Margin="0,16,0,0"
                     IsIndeterminate="True"
                     Foreground="#4a8cff"
                     Background="#1b1f2a"
                     BorderThickness="0"/>
      </StackPanel>
    </Border>

    <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />
  </Grid>
</Window>