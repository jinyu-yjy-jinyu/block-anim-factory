{
  "name": "block-anim-factory-desktop",
  "version": "0.4.3",
  "private": true,
  "description": "积木动画工厂 · Electron 桌面壳（Windows / macOS）",
  "author": "block-anim-factory",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test:server": "node test-server-security.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blockanim.factory",
    "productName": "积木动画工厂",
    "artifactName": "${name}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "server.mjs",
      "index.html",
      "src/**/*",
      "package.json"
    ],
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.graphics-design"
    },
    "win": {
      "target": ["nsis", "zip"]
    },
    "linux": {
      "target": ["AppImage", "tar.gz"]
    }
  }
}
